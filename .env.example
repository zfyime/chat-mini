# Your API Key for OpenAI
OPENAI_API_KEY=
# Provide proxy for OpenAI API. e.g. http://127.0.0.1:7890
HTTPS_PROXY=
# Custom base url for OpenAI API. default: https://api.openai.com
OPENAI_API_BASE_URL=
# Inject analytics or other scripts before </head> of the page
HEAD_SCRIPTS=
# Secret string for the project. Use for generating signatures for API calls
PUBLIC_SECRET_KEY=
# Set password for site, support multiple password separated by comma. If not set, site will be public
SITE_PASSWORD=
# Tavily API key for the web search tool. Leave empty to disable the toggle on the UI side.
TAVILY_API_KEY=
# Self-hosted SearXNG base url, e.g. https://searx.example.com. Used as fallback when Tavily fails.
# Requires json format enabled in SearXNG settings.yml (search.formats: [html, json]).
SEARXNG_BASE_URL=
# Stream watchdog (ms): truncate the stream with a notice before the platform wall clock (e.g. Vercel maxDuration) kills it.
# Unset: defaults to 55000 on Vercel, disabled for self-hosting. Set 0 to disable explicitly.
STREAM_TIMEOUT_MS=

